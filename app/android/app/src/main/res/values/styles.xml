<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/xsword_background</item>
        <item name="android:statusBarColor">@color/xsword_background</item>
        <item name="android:navigationBarColor">@color/xsword_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- The theme the game runs in (Capacitor switches to it after the splash). The page draws edge to edge on Android 15+;
         whatever shows behind the system bars is the window background, so it is the game's dark color, with light bar icons. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/xsword_background</item>
        <item name="android:statusBarColor">@color/xsword_background</item>
        <item name="android:navigationBarColor">@color/xsword_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>